# Copy to .env and adjust for local development
# Windows: copy .env.example .env

POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=taskmanager_dev
POSTGRES_DB=taskmanager
POSTGRES_PORT=5433

# Host development (dotnet run on machine, DB in Docker)
ConnectionStrings__DefaultConnection=Host=localhost;Port=5433;Database=taskmanager;Username=taskmanager;Password=taskmanager_dev

# JWT (Phase 3+ — use a long random secret in real environments)
Jwt__Secret=change-me-to-a-long-random-secret-at-least-32-chars
Jwt__Issuer=TaskManager
Jwt__Audience=TaskManager
Jwt__ExpirationMinutes=60

# Docker compose host ports (avoid conflicts with existing local containers)
API_PORT=8082
CLIENT_PORT=8083
ASPNETCORE_ENVIRONMENT=Development
